{
  "manifest_version": 2,
  "name": "DIR HELPER",
  "version": "12.5",
  "description": "DIR HELPER — раздача заявок CRM МНЧ мастерам, аналитика отчётов и зарплата директора.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mnc-otdat-mastery@local",
      "strict_min_version": "109.0",
      "update_url": "https://raw.githubusercontent.com/__OWNER__/dir-helper/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "notifications",
    "alarms",
    "storage",
    "clipboardWrite",
    "activeTab",
    "tabs",
    "*://*.mnc-lead-centre.ru/*",
    "webRequest",
    "webRequestBlocking",
    "https://api.telegram.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.mnc-lead-centre.ru/*"
      ],
      "js": [
        "charts.js",
        "dashboard.js",
        "content.js"
      ],
      "css": [
        "panel.css",
        "dashboard.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "tg.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "DIR HELPER",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_title": "DIR HELPER",
    "default_icon": "icon.svg",
    "open_at_install": false
  }
}